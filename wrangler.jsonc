{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "eightbits-us",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "eightbits.us/*",
      "zone_name": "eightbits.us"
    },
    {
      "pattern": "www.eightbits.us/*",
      "zone_name": "eightbits.us"
    }
  ],
  "observability": {
    "enabled": true
  }
}
